---
config:
    theme: base
    memorymap:
        crossSize: 360
        wrapWidth: 160
        padding: 0
        laneShares: { label: 23, section: 27, note: 50 }
        groupStyle:
            color: '#000000'
            fontFamily: Arial
            fontSize: 11
            strokeWidth: 0
            textAlign: right
        sectionStyle:
            fill: '#F4CCCC'
            stroke: '#555555'
            strokeWidth: 1
            color: '#000000'
            fontFamily: Arial
            fontSize: 11
            minLength: 27
            textAlign: center
            verticalAlign: middle
        noteStyle:
            color: '#000000'
            fontFamily: Arial
