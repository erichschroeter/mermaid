---
title: Dark memory map
config:
    theme: dark
---
memorymap-beta vertical
    accTitle: Dark memory map
    group "Bank A"
        section "Firmware"
            section "Boot"
            section "Application"
            note "Notes retain their independent theme defaults."
        section "Reserved"
            style "fill:#660000; color:#ffffff; stroke:none"
            note "A local reserved-region fill."
